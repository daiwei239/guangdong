APP_NAME=resource-state-data-pipeline
APP_VERSION=0.1.0
DEBUG=true

# Optional default input/output paths for local scripts.
PIPELINE_INPUT=examples/ResourceState.example.json
PIPELINE_OUTPUT=outputs/normalized-resource-state.json

# Kafka realtime input. Use node_id as the Kafka message key.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=resource-2-1-input
KAFKA_AUTO_OFFSET_RESET=latest
KAFKA_TOPIC_PREFIX=resource

# Default topics consumed by the 2.1 input layer:
# resource.management_config
# resource.agent_collect
# resource.realtime_monitor
# resource.device_plugin
# resource.topology_probe
# resource.scheduler_queue
# resource.asset_ops
# resource.analytics_history
