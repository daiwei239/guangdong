APP_NAME=semi-real-backend
APP_VERSION=0.1.0
DEBUG=true
API_PREFIX=/api

# Docker Compose 基础变量
BACKEND_PORT=8000
POSTGRES_DB=guangdong_resource_mapping
POSTGRES_USER=guangdong_user
POSTGRES_PASSWORD=guangdong_pass
POSTGRES_PORT=5432
NEO4J_ENABLED=true
NEO4J_USER=neo4j
NEO4J_PASSWORD=guangdong_pass
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
REDIS_ENABLED=false
REDIS_PORT=6379

# 本机运行 backend，数据库在 Docker 中时使用 localhost
DATABASE_URL=postgresql+psycopg://guangdong_user:guangdong_pass@localhost:5432/guangdong_resource_mapping
POSTGRES_URL=postgresql+psycopg://guangdong_user:guangdong_pass@localhost:5432/guangdong_resource_mapping
NEO4J_URI=bolt://localhost:7687
REDIS_URL=redis://localhost:6379/0
